    { "type": "text", "id": "caption", "x": 130, "y": 600, "width": 720, "height": 44, "text": "Each shard scans its slice and ships it whole. Both join inputs — and every intermediate result —\nmust be resident on the coordinator at once. The largest join the cluster can run is bounded by one heap.", "originalText": "Each shard scans its slice and ships it whole. Both join inputs — and every intermediate result —\nmust be resident on the coordinator at once. The largest join the cluster can run is bounded by one heap.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300050, "version": 1, "versionNonce": 50, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.35 }
