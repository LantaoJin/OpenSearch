    { "type": "text", "id": "p2_note", "x": 560, "y": 150, "width": 410, "height": 90, "text": "Real row counts seed the cost model.\nBoth joins are large × large → shuffle.\n(Were customer tiny, this join would\nbroadcast instead — chosen by cost.)", "originalText": "Real row counts seed the cost model.\nBoth joins are large × large → shuffle.\n(Were customer tiny, this join would\nbroadcast instead — chosen by cost.)", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400134, "version": 1, "versionNonce": 134, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.3 },

