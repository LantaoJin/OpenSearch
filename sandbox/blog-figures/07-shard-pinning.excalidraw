    { "type": "text", "id": "caption", "x": 110, "y": 620, "width": 1000, "height": 44, "text": "Stages are built around where data already lives: one scan per stage, resolved to its shard's node. The shuffle\nworker tier layers on top of those shard-local producers — it can sit on any node, because shuffle moves the rows to it.", "originalText": "Stages are built around where data already lives: one scan per stage, resolved to its shard's node. The shuffle\nworker tier layers on top of those shard-local producers — it can sit on any node, because shuffle moves the rows to it.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700060, "version": 1, "versionNonce": 60, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.35 }
