    { "type": "text", "id": "L_cap", "x": 80, "y": 555, "width": 540, "height": 60, "text": "A textbook broadcast is its own stage. But under shard-locality\nthis stage must scan its shard, receive a broadcast build, AND ship\nits shuffle partition — three jobs, one stage. Roles collide.", "originalText": "A textbook broadcast is its own stage. But under shard-locality\nthis stage must scan its shard, receive a broadcast build, AND ship\nits shuffle partition — three jobs, one stage. Roles collide.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 800023, "version": 1, "versionNonce": 23, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.35 },

