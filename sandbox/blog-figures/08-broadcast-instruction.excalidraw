    { "type": "text", "id": "R_cap", "x": 740, "y": 555, "width": 560, "height": 60, "text": "The small build is captured once, then injected into the stage that\nconsumes it as an instruction. That stage stays a plain shuffle producer\n— the build just rides along as data. One stage, one role.", "originalText": "The small build is captured once, then injected into the stage that\nconsumes it as an instruction. That stage stays a plain shuffle producer\n— the build just rides along as data. One stage, one role.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 800044, "version": 1, "versionNonce": 44, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "lineHeight": 1.35 }
